# LLM Providers (Obtain from console.groq.com and aistudio.google.com)
GROQ_API_KEY=gsk_your_key_here
GEMINI_API_KEY=AIzaSy_your_key_here

# Database Configuration (Defaults configured for Docker Compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/llm_logging?sslmode=disable

# Redis Configuration (Defaults configured for Docker Compose)
REDIS_URL=redis://localhost:6379

# Ingestion API Key (Secret key used for Express API authentication)
INGEST_API_KEY=default-secret-key-1234567890123456

# Upstash Redis REST Config (Optional - For production Serverless deployments)
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_token_here

# Frontend variables (Vite requires build-time variables starting with VITE_)
VITE_API_URL=http://localhost:4000
VITE_INGEST_API_KEY=default-secret-key-1234567890123456
